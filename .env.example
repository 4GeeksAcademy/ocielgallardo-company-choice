# Auth
SECRET_KEY=cambia-esto-por-una-cadena-larga-y-secreta
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Celery broker and result backend (shared by API, worker, and Flower)
REDIS_URL=redis://redis:6379/0

# Qdrant vector DB (Compose service hostname inside the network; host browser/tools use localhost)
QDRANT_URL=http://qdrant:6333

# RAG: generation via Groq, embeddings via OpenRouter (OpenAI-compatible) — secrets only in local .env, never commit real keys
EMBEDDING_API_KEY=
EMBEDDING_API_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
EMBEDDING_DIM=2048

# RAG: generation via Groq, embeddings via OpenRouter (OpenAI-compatible) — secrets only in local .env, never commit real keys
LLM_API_KEY=
LLM_API_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
RAG_COLLECTION=healthcore_knowledge

# Agent memory (hito 26) — episodic store separate from the RAG collections.
# backend: memory (process-local, default outside Docker) | redis (Compose sets this).
AGENT_MEMORY_BACKEND=memory
# Optional tuning (defaults shown): entry TTL, per-clinic/category cap, audit cap + TTL,
# pending-proposal TTL (silence = rejected by default after this), sweep throttle.
# AGENT_MEMORY_TTL_DAYS=180
# AGENT_MEMORY_MAX_ENTRIES_PER_KEY=20
# AGENT_MEMORY_AUDIT_MAX=1000
# AGENT_MEMORY_AUDIT_TTL_DAYS=90
# AGENT_MEMORY_PENDING_TTL_HOURS=168
# AGENT_MEMORY_SWEEP_INTERVAL_S=600

# Agent external tools (Part 2) — backend-to-API reads for live ticket/stock data.
# URL of the HealthCore API the tools call (container-to-container uses the
# Compose service name; host tools use localhost).
AGENT_TOOL_API_URL=http://127.0.0.1:8000
# Service identity (client-credentials, agent-graph.md §9.1): machine principal
# svc:langgraph-agent instead of a pasted user JWT. Obtain the secret with:
#   PYTHONPATH=. uv run python scripts/seed_service_client.py
# (re-running rotates the secret). Secrets only in local .env, never commit.
# Prefer AGENT_TOOL_CLIENT_SECRET_FILE=/run/secrets/... in Docker.
AGENT_TOOL_CLIENT_ID=langgraph-agent
AGENT_TOOL_CLIENT_SECRET=
# AGENT_TOOL_CLIENT_SECRET_FILE=
# TTL of the short-lived service JWT minted by POST /auth/token (minutes).
SERVICE_TOKEN_EXPIRE_MINUTES=15

# --- OAuth 2.1 / OIDC (API as authorization server, hito 25) ---
# The API publishes /.well-known/openid-configuration + /.well-known/jwks.json
# and signs service tokens RS256; the MCP server (mcpauth) fetches this issuer.
# `iss` in every service token MUST equal this value; it is also the default
# `aud`. In Docker Compose the issuer name stays as-is while
# MCP_AUTH_ISSUER_URL only decides where discovery is fetched from.
OAUTH_ISSUER_URL=http://localhost:8000
# Default audience stamped on service tokens (defaults to OAUTH_ISSUER_URL).
# The agent overrides it per grant with the MCP resource URL (RFC 8707).
# OAUTH_TOKEN_AUDIENCE=http://localhost:8000
# RS256 key material; auto-generated (gitignored) when unset:
# OAUTH_JWT_PRIVATE_KEY_FILE=data/process/auth/oauth_service_signing_key.pem
# OAUTH_JWT_PRIVATE_KEY_PEM=

# --- MCP server (incidents + inventory tools) ---
# The agent reaches the MCP server when MCP_SERVER_URL is set; MCP is the
# only transport (the direct HTTP tool path was removed for hito 25 — an
# unset MCP_SERVER_URL makes lookups fail honestly as `unavailable`).
# In Docker Compose the endpoint is overridden to http://mcp:8100/mcp.
# Agent → MCP endpoint (Streamable HTTP).
MCP_SERVER_URL=http://127.0.0.1:8100/mcp
# MCP resource identity (RFC 9728 metadata + RFC 8707 `aud`): the MCP server
# advertises it in /.well-known/oauth-protected-resource and in the 401
# WWW-Authenticate, and demands it as the token `aud`.
# For the MCP Playground validation set the Codespaces public URL:
#   MCP_RESOURCE_URL=https://<codespace>-8100.app.github.dev/mcp
MCP_RESOURCE_URL=http://localhost:8100/mcp
# Authorization server (the HealthCore API) that issues the service tokens.
MCP_AUTH_ISSUER_URL=http://localhost:8000
# Optional: replace the `jwks_uri` that the discovery document advertises.
# Only needed when the issuer's advertised JWKS URL is not reachable from the
# MCP server process (Docker Compose: the mcp container resolves `backend`,
# not `localhost`), while tokens keep `iss` = OAUTH_ISSUER_URL.
# MCP_AUTH_JWKS_URI=http://localhost:8000/.well-known/jwks.json
# MCP server → API base URL and its own service identity.
MCP_BACKEND_URL=http://127.0.0.1:8000
MCP_BACKEND_CLIENT_ID=mcp-server
MCP_BACKEND_CLIENT_SECRET=
# MCP_BACKEND_CLIENT_SECRET_FILE=/run/secrets/mcp_backend_client_secret
# Register/rotate the MCP identity:
#   PYTHONPATH=. uv run python scripts/seed_service_client.py \
#       --client-id mcp-server --env-prefix MCP_BACKEND \
#       --scopes incidents:read incidents:write inventory:read
# Per-tool call budget on the agent side (seconds); a slower or failing MCP
# hop surfaces an honest `unavailable` contract failure (no fallback path).
MCP_TOOL_TIMEOUT_SECONDS=10
# DNS-rebinding allowlists for the MCP server (comma-separated patterns);
# defaults already cover loopback, the `mcp` compose service and testserver.
# MCP_ALLOWED_HOSTS=mcp:*,127.0.0.1:*,localhost:*
# MCP_ALLOWED_ORIGINS=http://mcp:*,http://127.0.0.1:*,http://localhost:*

# Supabase inventory (Transaction / Shared pooler)
# Supabase dashboard: Connect → Transaction pooler → URI (use discrete vars below)
SUPABASE_DB_HOST=aws-1-eu-west-1.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.zazatgnieynvuuwfevmv
SUPABASE_DB_PASSWORD=YOUR_PASSWORD_HERE

# Optional override: full URI (password must be percent-encoded if it has special chars)
# DATABASE_URL=postgresql://postgres.REF:ENCODED_PASSWORD@aws-1-eu-west-1.pooler.supabase.com:6543/postgres

# Password reset (AUTH-03) — secrets only in local .env, never commit real keys
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
# Backoffice runs on :3001 in Docker Compose (website on :3000)
FRONTEND_BASE_URL=http://localhost:3001
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_EMAIL_PROVIDER=resend
# Set to false only on local Windows/proxy SSL failures (never in production)
EMAIL_SSL_VERIFY=true

# --- UI (Docker Compose / Next.js) ---
# Browser → API via published host port (NOT http://backend:8000 — that hostname
# only resolves inside the Docker network; NEXT_PUBLIC_* is inlined at build time for prod).
# Container-to-container calls use the Compose service name: http://backend:8000
# Production (default): docker compose up --build  (or npm run docker:up)
# Development (hot reload): docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build  (or npm run docker:dev)
NEXT_PUBLIC_HEALTHCORE_API_URL=http://localhost:8000
NEXT_PUBLIC_TRACKER_API_URL=https://playground.4geeks.com/tracker/api/v1
TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events
NEXT_PUBLIC_TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events
