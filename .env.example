# Environment variables authentication
SECRET_KEY=cambia-esto-por-una-cadena-larga-y-secreta
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Password reset (AUTH-03) — secrets only in local .env, never commit real keys
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
FRONTEND_BASE_URL=http://localhost:3000
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_EMAIL_PROVIDER=resend
# Set to false only on local Windows/proxy SSL failures (never in production)
EMAIL_SSL_VERIFY=true
