# Auth
SECRET_KEY=cambia-esto-por-una-cadena-larga-y-secreta
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Supabase inventory (Transaction / Shared pooler)
# Supabase dashboard: Connect → Transaction pooler → URI (use discrete vars below)
SUPABASE_DB_HOST=aws-1-eu-west-1.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.zazatgnieynvuuwfevmv
SUPABASE_DB_PASSWORD=YOUR_PASSWORD_HERE

# Optional override: full URI (password must be percent-encoded if it has special chars)
# DATABASE_URL=postgresql://postgres.REF:ENCODED_PASSWORD@aws-1-eu-west-1.pooler.supabase.com:6543/postgres

# Password reset (AUTH-03) — secrets only in local .env, never commit real keys
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
# Backoffice runs on :3001 in Docker Compose (website on :3000)
FRONTEND_BASE_URL=http://localhost:3001
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_EMAIL_PROVIDER=resend
# Set to false only on local Windows/proxy SSL failures (never in production)
EMAIL_SSL_VERIFY=true

# --- UI (Docker Compose / Next.js) ---
# Browser → API via published host port (NOT http://backend:8000 — that hostname
# only resolves inside the Docker network; NEXT_PUBLIC_* is inlined at build time for prod).
# Container-to-container calls use the Compose service name: http://backend:8000
# Production (default): docker compose up --build  (or npm run docker:up)
# Development (hot reload): docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build  (or npm run docker:dev)
NEXT_PUBLIC_HEALTHCORE_API_URL=http://localhost:8000
NEXT_PUBLIC_TRACKER_API_URL=https://playground.4geeks.com/tracker/api/v1
