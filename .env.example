# Auth
SECRET_KEY=cambia-esto-por-una-cadena-larga-y-secreta
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Celery broker and result backend (shared by API, worker, and Flower)
REDIS_URL=redis://redis:6379/0

# Qdrant vector DB (Compose service hostname inside the network; host browser/tools use localhost)
QDRANT_URL=http://qdrant:6333

# RAG: generation via Groq, embeddings via OpenRouter (OpenAI-compatible) — secrets only in local .env, never commit real keys
EMBEDDING_API_KEY=
EMBEDDING_API_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
EMBEDDING_DIM=2048

# RAG: generation via Groq, embeddings via OpenRouter (OpenAI-compatible) — secrets only in local .env, never commit real keys
LLM_API_KEY=
LLM_API_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
RAG_COLLECTION=healthcore_knowledge

# Agent external tools (Part 2) — backend-to-API reads for live ticket/stock data.
# URL of the HealthCore API the tools call (container-to-container uses the
# Compose service name; host tools use localhost).
AGENT_TOOL_API_URL=http://127.0.0.1:8000
# Service identity (client-credentials, agent-graph.md §9.1): machine principal
# svc:langgraph-agent instead of a pasted user JWT. Obtain the secret with:
#   PYTHONPATH=. uv run python scripts/seed_service_client.py
# (re-running rotates the secret). Secrets only in local .env, never commit.
# Prefer AGENT_TOOL_CLIENT_SECRET_FILE=/run/secrets/... in Docker.
AGENT_TOOL_CLIENT_ID=langgraph-agent
AGENT_TOOL_CLIENT_SECRET=
# AGENT_TOOL_CLIENT_SECRET_FILE=
# TTL of the short-lived service JWT minted by POST /auth/token (minutes).
SERVICE_TOKEN_EXPIRE_MINUTES=15

# Supabase inventory (Transaction / Shared pooler)
# Supabase dashboard: Connect → Transaction pooler → URI (use discrete vars below)
SUPABASE_DB_HOST=aws-1-eu-west-1.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.zazatgnieynvuuwfevmv
SUPABASE_DB_PASSWORD=YOUR_PASSWORD_HERE

# Optional override: full URI (password must be percent-encoded if it has special chars)
# DATABASE_URL=postgresql://postgres.REF:ENCODED_PASSWORD@aws-1-eu-west-1.pooler.supabase.com:6543/postgres

# Password reset (AUTH-03) — secrets only in local .env, never commit real keys
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
# Backoffice runs on :3001 in Docker Compose (website on :3000)
FRONTEND_BASE_URL=http://localhost:3001
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_EMAIL_PROVIDER=resend
# Set to false only on local Windows/proxy SSL failures (never in production)
EMAIL_SSL_VERIFY=true

# --- UI (Docker Compose / Next.js) ---
# Browser → API via published host port (NOT http://backend:8000 — that hostname
# only resolves inside the Docker network; NEXT_PUBLIC_* is inlined at build time for prod).
# Container-to-container calls use the Compose service name: http://backend:8000
# Production (default): docker compose up --build  (or npm run docker:up)
# Development (hot reload): docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build  (or npm run docker:dev)
NEXT_PUBLIC_HEALTHCORE_API_URL=http://localhost:8000
NEXT_PUBLIC_TRACKER_API_URL=https://playground.4geeks.com/tracker/api/v1
TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events
NEXT_PUBLIC_TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events
