                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "supply_expiry_flagged": {
      "title": "supply_expiry_flagged",
      "x-priority": "P0",
      "x-pipeline": "batch",
      "allOf": [
        { "$ref": "#/$defs/envelope_fields" },
        {
          "type": "object",
          "properties": {
            "event_type": { "const": "supply_expiry_flagged" },
            "properties": {
              "allOf": [
                { "$ref": "#/$defs/inventory_core" },
                {
                  "type": "object",
                  "required": ["expiry_date", "days_to_expiry"]
                }
              ]
            }
          }
        }
      ]
    },
    "product_created": {
      "title": "product_created",
      "x-priority": "P1",
      "x-pipeline": "batch",
      "allOf": [
        { "$ref": "#/$defs/envelope_fields" },
        {
          "type": "object",
          "properties": {
            "event_type": { "const": "product_created" },
            "properties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "product_id",
                "product_category",
                "country",
                "sku"
              ],
              "properties": {
                "product_id": { "type": "integer", "minimum": 1 },
                "product_category": { "$ref": "#/$defs/product_category" },
                "country": { "$ref": "#/$defs/country" },
                "sku": { "type": "string" },
                "unit": { "type": "string" },
                "clinic_id": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12
                },
                "quantity": { "type": "integer", "const": 0 }
              }
            }
          }
        }
      ]
    },
    "outbound_order_rejected": {
      "title": "outbound_order_rejected",
      "x-priority": "P1",
      "x-pipeline": "batch",
      "allOf": [
        { "$ref": "#/$defs/envelope_fields" },
        {
          "type": "object",
          "properties": {
