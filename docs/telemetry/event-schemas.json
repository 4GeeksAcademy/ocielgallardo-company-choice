{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://healthcore.local/schemas/telemetry/event-schemas.json",
  "title": "HealthCore Telemetry Event Schemas",
  "description": "JSON Schema catalog for HealthCore telemetry. Identifiers match CONTEXT-healthcore.md and telemetry-plan.md. No PHI in properties.",
  "x-priority-index": {
    "P0": [
      "inbound_order_created",
      "outbound_order_created",
      "stock_threshold_triggered",
      "direct_stock_edit_rejected",
      "supply_expiry_flagged"
    ],
    "P1": [
      "product_created",
      "outbound_order_rejected",
      "inbound_order_rejected",
      "inventory_form_started",
      "inventory_form_abandoned",
      "login_succeeded",
      "login_failed",
      "logout_completed",
      "user_registered",
      "password_reset_requested",
      "password_reset_completed",
      "password_reset_failed",
      "password_changed",
      "session_unauthorized",
      "page_viewed",
      "form_abandoned",
      "incident_created",
      "incident_validation_failed",
      "incident_status_changed",
      "incident_status_rejected",
      "incident_csv_analyzed",
      "incident_csv_rejected",
      "incident_results_exported",
      "incident_summary_viewed",
      "supplier_created",
      "supplier_rate_updated",
      "supplier_status_changed",
      "supplier_deleted",
      "http_request_failed",
      "api_unhandled_error",
      "email_send_failed",
      "job_run_completed"
    ],
    "P2": [
      "talent_list_filtered",
      "talent_record_created",
      "talent_candidate_viewed",
      "website_page_viewed",
      "intake_form_started",
      "intake_form_submitted",
      "intake_form_validation_failed"
    ]
  },
  "$defs": {
    "iso8601": {
      "type": "string",
      "format": "date-time"
    },
    "country": {
      "type": "string",
      "enum": ["US", "UK"]
    },
    "product_category": {
      "type": "string",
      "enum": ["medication", "ppe", "consumable", "equipment"]
    },
    "app_surface": {
      "type": "string",
      "enum": ["backoffice", "website"]
    },
    "envelope_fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "timestamp",
        "sessionId",
        "userId",
        "event_type",
        "schemaVersion",
        "requestId",
        "properties"
      ],
      "properties": {
        "eventId": { "type": "string", "format": "uuid" },
        "timestamp": { "$ref": "#/$defs/iso8601" },
        "sessionId": { "type": ["string", "null"] },
        "userId": { "type": "string", "minLength": 1 },
        "event_type": { "type": "string", "minLength": 1 },
        "schemaVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "requestId": { "type": ["string", "null"] },
        "properties": { "type": "object" }
      }
    },
    "inventory_core": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clinic_id",
        "country",
        "product_id",
        "product_category",
        "quantity"
      ],
      "properties": {
        "clinic_id": { "type": "integer", "minimum": 1, "maximum": 12 },
        "country": { "$ref": "#/$defs/country" },
        "product_id": { "type": "integer", "minimum": 1 },
        "product_category": { "$ref": "#/$defs/product_category" },
        "quantity": { "type": "integer", "minimum": 0 },
        "department": {
          "type": "string",
          "minLength": 1,
          "description": "Clinical service area; never a patient id"
        },
        "sku": { "type": "string" },
        "unit": { "type": "string" },
        "order_id": { "type": "integer", "minimum": 1 },
        "vendor_name": { "type": "string" },
        "consumption_type": {
          "type": "string",
          "enum": ["clinical_use", "expiry_waste"]
        },
        "current_stock": { "type": "integer", "minimum": 0 },
        "min_stock_threshold": { "type": "integer", "minimum": 0 },
        "threshold_band": { "type": "string", "enum": ["low", "critical"] },
        "attempted_path": { "type": "string" },
        "http_status": { "type": "integer", "minimum": 100, "maximum": 599 },
        "rejection_reason": { "type": "string" },
        "expiry_date": { "type": "string", "format": "date" },
        "days_to_expiry": { "type": "integer" },
        "batch_id": { "type": "string" },
        "form_name": {
          "type": "string",
          "enum": ["inbound", "outbound", "product_create"]
        },
        "error_code": { "type": "string" }
      }
    },
    "inbound_order_created": {
      "title": "inbound_order_created",
      "x-priority": "P0",
      "x-pipeline": "batch",
      "allOf": [
        { "$ref": "#/$defs/envelope_fields" },
        {
          "type": "object",
          "properties": {
            "event_type": { "const": "inbound_order_created" },
            "properties": {
              "allOf": [
                { "$ref": "#/$defs/inventory_core" },
                {
                  "type": "object",
                  "required": ["vendor_name"]
                }
              ]
            }
          }
        }
      ]
    },
    "outbound_order_created": {
      "title": "outbound_order_created",
      "x-priority": "P0",
      "x-pipeline": "batch",
      "allOf": [
        { "$ref": "#/$defs/envelope_fields" },
        {
          "type": "object",
          "properties": {
            "event_type": { "const": "outbound_order_created" },
            "properties": {
              "allOf": [
                { "$ref": "#/$defs/inventory_core" },
                {
                  "type": "object",
                  "required": ["department"]
                }
              ]
            }
          }
        }
      ]
    },
    "stock_threshold_triggered": {
      "title": "stock_threshold_triggered",
      "x-priority": "P0",
      "x-pipeline": "stream",
      "allOf": [
        { "$ref": "#/$defs/envelope_fields" },
