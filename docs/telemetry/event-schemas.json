      ]
    },
    "direct_stock_edit_rejected": {
      "title": "direct_stock_edit_rejected",
      "x-priority": "P0",
      "x-pipeline": "stream",
      "allOf": [
        { "$ref": "#/$defs/envelope_fields" },
        {
          "type": "object",
          "properties": {
            "event_type": { "const": "direct_stock_edit_rejected" },
            "properties": {
              "allOf": [
                { "$ref": "#/$defs/inventory_core" },
                {
                  "type": "object",
                  "required": [
                    "attempted_path",
