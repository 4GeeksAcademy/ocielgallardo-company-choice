{
  // HealthCore Codespace: enough tooling to run the API + MCP server and do
  // the MCP Playground validation of hito 25 (public port 8100 forwarding).
  "name": "healthcore-mcp",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  // Ports: API (OIDC issuer/backend) and MCP server (the one Playground uses).
  "forwardPorts": [8000, 8100],
  "portsAttributes": {
    "8000": {
      "label": "HealthCore API (issuer + Incidents Manager)",
      "onAutoForward": "notify"
    },
    "8100": {
      "label": "MCP server (set Visibility=Public for MCP Playground)",
      "onAutoForward": "notify"
    }
  },
  // Docker compose (backend + mcp) runs inside the Codespace.
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": true
    }
  },
  "remoteEnv": {
    // uv installs to ~/.local/bin; keep it on PATH for every session.
    "PATH": "/home/vscode/.local/bin:${containerEnv:PATH}"
  },
  "postCreateCommand": "bash -lc 'command -v uv >/dev/null || { curl -LsSf https://astral.sh/uv/install.sh | sh; }; uv sync'",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "astral-sh.uv",
        "ms-azuretools.vscode-docker"
      ]
    }
  },
  "remoteUser": "vscode"
}
